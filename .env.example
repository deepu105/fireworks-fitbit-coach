AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
# Generate with: openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
# Name of your Auth0 custom OAuth2 connection for Google Health.
AUTH0_FITBIT_CONNECTION=google-health
# Report cutoff only; readings keep their recorded local dates.
REPORT_TIME_ZONE=Europe/Amsterdam

# Developer-supplied model key; only the backend reads it.
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/kimi-k3

# Google OAuth client credentials belong in the Auth0 connection, not here.

# Development-only fixture provider; requires its own Auth0 connection.
MOCK_GOOGLE_HEALTH=false
